# Desenvolvimento: só o Supabase local (npx supabase start). Nunca o da nuvem.
# Copie para .env.local; a service key sai de `npx supabase status -o env` (SERVICE_ROLE_KEY).
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_SERVICE_KEY=
SERVER_SALT=dev-salt

# Auth.js: AUTH_SECRET qualquer em dev (openssl rand -base64 32).
AUTH_SECRET=
# Login de dev (sem Google): só funciona com `next dev`. Entra como ADMIN_EMAIL.
AUTH_DEV_LOGIN=1
ADMIN_EMAIL=dev@localhost
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Hosts extras para abrir o next dev pela rede (next.config.ts)
DEV_ORIGINS=
